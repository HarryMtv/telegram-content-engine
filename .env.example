# ============================================================
# Telegram Content Engine — шаблон окружения.
# Скопируй в .env и заполни обязательное. Полный справочник — docs/CONFIGURATION.md.
# Скрипты читают .env автоматически (node --env-file-if-exists=.env);
# в Coolify переменные задаются в UI — файл внутрь контейнера не попадает.
# ============================================================

# --- БД (обязательно) ---
# Supabase pooler (transaction mode) — приложение, очередь pg-boss и миграции.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-eu-west-1.pooler.supabase.com:6543/postgres
# Прямое подключение опционально (у новых проектов Supabase оно только IPv6);
# если не задано — используется DATABASE_URL.
# DATABASE_URL_DIRECT=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# --- Telegram (обязательно) ---
TELEGRAM_BOT_TOKEN=123456:ABC...
# Канал публикации (формат Bot API: -100 + id канала)
TELEGRAM_CHANNEL_CHAT_ID=-1001234567890
# Владелец/редактор: ему идут батчи и кнопки. Без переменной api/scheduler/worker не стартуют.
TELEGRAM_OWNER_CHAT_ID=123456789
TELEGRAM_WEBHOOK_SECRET=change-me-8-chars-min
# Вебхук (прод): публичный HTTPS-URL. Не задан → long polling (удобно локально).
# TELEGRAM_WEBHOOK_URL=https://<домен>/api/telegram/webhook

# --- HTTP API ---
# Bearer-токен для POST /ingest (минимум 8 символов; дефолт ниже — только для разработки)
INGEST_TOKEN=change-me
# Среда: development | production (дефолт development)
# APP_ENV=production
# Порт HTTP api и per-process health-эндпоинта (дефолты 8080 и 8081;
# worker-mtproto слушает health на HEALTH_PORT+1, worker-agents на HEALTH_PORT+2)
# API_PORT=8080
# HEALTH_PORT=8081

# --- Ключи провайдеров (обязателен хотя бы один LLM-ключ + COHERE) ---
# Дефолтный провайдер подставляется автоматически, приоритет: openrouter → deepseek → openai.
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
COHERE_API_KEY=
# Устаревшие алиасы, читаются если основных нет: LLM_API_KEY (=OPENAI), EMBEDDINGS_API_KEY (=COHERE)

# --- LLM cheap: триаж, FactSheet, черновики ---
# Провайдеры: openai | openrouter | deepseek | groq | custom
LLM_CHEAP_PROVIDER=deepseek
LLM_CHEAP_MODEL=deepseek-v4-flash
LLM_CHEAP_INPUT_PRICE=0.10
LLM_CHEAP_OUTPUT_PRICE=0.20
# Переопределения (не заданы → дефолты провайдера и KNOWN_MODELS):
# LLM_CHEAP_BASE_URL=
# LLM_CHEAP_API_KEY=

# --- LLM strong: «переписать лучше», агенты ---
LLM_STRONG_PROVIDER=deepseek
LLM_STRONG_MODEL=deepseek-v4-pro
LLM_STRONG_INPUT_PRICE=0.55
LLM_STRONG_OUTPUT_PRICE=2.19
# LLM_STRONG_BASE_URL=
# LLM_STRONG_API_KEY=

# --- Эмбеддинги: кластеризация stories, MMR-разнообразие, profile_vector ---
# Провайдеры: cohere | openai | custom. Размерность зафиксирована схемой БД (1024).
EMBEDDING_PROVIDER=cohere
EMBEDDING_MODEL=embed-multilingual-v3.0
EMBEDDING_DIMENSIONS=1024
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=

# --- MTProto: метрики постов через GramJS (опционально) ---
# Без TG_API_ID/TG_API_HASH worker-mtproto работает в mock-режиме
# и пишет фиктивные метрики (в лог будет предупреждение).
# TG_API_ID=
# TG_API_HASH=
# Строковая сессия StringSession (получается один раз при логине аккаунта).
# TG_SESSION=
# Зарезервировано, пока не используется кодом.
# TG_SESSION_PATH=./data/tg-session

# --- Веб-поиск для автономных агентов (Scout, Resolver) ---
# Провайдеры: tavily (дефолт) | brave | mock
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
# BRAVE_SEARCH_API_KEY=

# --- Локальная разработка ---
# Только для локального Supabase MCP в Claude Code (.mcp.json); приложению не нужен.
# SUPABASE_ACCESS_TOKEN=

